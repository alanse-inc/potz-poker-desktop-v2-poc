# ============================================================
# Tauri Updater 設定
# ============================================================
# アップデートサーバーのエンドポイント URL。
# tauri.conf.json の plugins.updater.endpoints に設定する。
# 例: https://releases.example.com/updater/{{target}}/{{arch}}/{{current_version}}
TAURI_UPDATER_ENDPOINT=https://example.com/updater/{{target}}/{{arch}}/{{current_version}}

# tauri signer generate で生成した公開鍵 (base64 文字列)。
# tauri.conf.json の plugins.updater.pubkey に設定する。
TAURI_UPDATER_PUBKEY=

# ============================================================
# Tauri ビルド署名鍵 (CI/CD 環境で使用)
# ============================================================
# tauri signer generate で生成した秘密鍵 (base64 文字列)。
# GitHub Actions では Secrets に登録して CI で参照する。
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
