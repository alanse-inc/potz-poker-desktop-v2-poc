{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PotzPokerProPoC",
  "version": "0.1.0",
  "identifier": "com.potz.poker.poc",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "main",
        "title": "Potz Poker Pro (Tauri PoC)",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; script-src 'self' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' wss://api.deepgram.com https://api.deepgram.com ipc: http://ipc.localhost; worker-src 'self' blob:; media-src 'self' blob: mediastream:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "category": "Game",
    "shortDescription": "Potz Poker Pro Tauri PoC",
    "longDescription": "Proof-of-concept Tauri 2 port of the Potz Poker Pro Electron desktop application."
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["com.potz.poker"]
      }
    },
    "updater": {
      "active": false,
      "endpoints": [
        "https://example.com/updater/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "",
      "dialog": false
    }
  }
}
