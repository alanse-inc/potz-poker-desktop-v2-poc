{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PotzPokerProPoC",
  "version": "0.1.0",
  "identifier": "com.potz.poker.poc",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Potz Poker Pro (Tauri PoC)",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "category": "Game",
    "shortDescription": "Potz Poker Pro Tauri PoC",
    "longDescription": "Proof-of-concept Tauri 2 port of the Potz Poker Pro Electron desktop application."
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://example.com/updater/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "",
      "dialog": false
    }
  }
}
